Vagrant.configure("2") do |config|
  {% for target in targets %}
  config.vm.define "{{ target.name }}_{{ session_id }}" do |node|
    node.vm.box = "{{ target.os }}"
    node.vm.hostname = "{{ target.name }}"
    
    # 网络配置 - 使用私有网络
    node.vm.network "private_network", type: "dhcp"
    
    # 资源分配
    node.vm.provider "virtualbox" do |vb|
      vb.memory = {{ target.memory }}
      vb.cpus = {{ target.cpu }}
      vb.name = "{{ target.name }}_{{ session_id }}"
      vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    end
    
    # 基础配置
    node.vm.provision "shell", inline: <<-SHELL
      # 更新系统
      apt-get update
      
      # 安装基础工具
      apt-get install -y python3 python3-pip curl wget netcat net-tools vim
      
      # 配置时区
      timedatectl set-timezone Asia/Shanghai
      
      # 创建常用目录
      mkdir -p /var/www/html
      chmod 755 /var/www/html
    SHELL
    
    {% if 'apache2' in target.services %}
    # 安装Web服务
    node.vm.provision "shell", inline: <<-SHELL
      apt-get install -y apache2 php libapache2-mod-php php-mysql php-curl php-xml php-mbstring
      
      # 启动Apache
      systemctl enable apache2
      systemctl start apache2
      
      # 创建phpinfo页面
      echo "<?php phpinfo(); ?>" > /var/www/html/info.php
      
      # 设置权限
      chown -R www-data:www-data /var/www/html
      chmod -R 755 /var/www/html
    SHELL
    {% endif %}
    
    {% if 'mysql' in target.services %}
    # 安装MySQL
    node.vm.provision "shell", inline: <<-SHELL
      apt-get install -y mysql-server
      
      # 启动MySQL
      systemctl enable mysql
      systemctl start mysql
      
      # 配置MySQL
      mysql -e "CREATE DATABASE IF NOT EXISTS testdb;"
      mysql -e "CREATE USER IF NOT EXISTS 'test'@'localhost' IDENTIFIED BY 'test';"
      mysql -e "GRANT ALL PRIVILEGES ON testdb.* TO 'test'@'localhost';"
      mysql -e "CREATE USER IF NOT EXISTS 'root'@'%' IDENTIFIED BY 'root';"
      mysql -e "GRANT ALL PRIVILEGES ON *.* TO 'root'@'%' WITH GRANT OPTION;"
      mysql -e "FLUSH PRIVILEGES;"
      
      # 修改配置允许远程连接
      sed -i 's/bind-address.*/bind-address = 0.0.0.0/' /etc/mysql/mysql.conf.d/mysqld.cnf
      systemctl restart mysql
    SHELL
    {% endif %}
    
    {% if target.type == 'attacker' %}
    # 安装攻击工具
    node.vm.provision "shell", inline: <<-SHELL
      apt-get install -y nmap sqlmap hydra john gobuster dirb
      
      # 安装Metasploit
      curl https://raw.githubusercontent.com/rapid7/metasploit-omnibus/master/config/templates/metasploit-framework-wrappers/msfupdate.erb > msfinstall
      chmod 755 msfinstall
      ./msfinstall
    SHELL
    {% endif %}
    
    {% if 'waf' in target.defense_tools %}
    # 安装ModSecurity WAF
    node.vm.provision "shell", inline: <<-SHELL
      apt-get install -y libapache2-mod-security2
      cp /etc/modsecurity/modsecurity.conf-recommended /etc/modsecurity/modsecurity.conf
      sed -i 's/SecRuleEngine DetectionOnly/SecRuleEngine On/' /etc/modsecurity/modsecurity.conf
      
      # 下载OWASP核心规则集
      cd /usr/share/modsecurity-crs
      git clone https://github.com/coreruleset/coreruleset.git
      
      systemctl restart apache2
    SHELL
    {% endif %}
    
    {% if 'snort' in target.defense_tools %}
    # 安装Snort IDS
    node.vm.provision "shell", inline: <<-SHELL
      apt-get install -y snort
      systemctl enable snort
    SHELL
    {% endif %}
  end
  {% endfor %}
end